# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create a $5/month recurring Price in Stripe Dashboard, then paste its ID:
STRIPE_PRICE_ID=price_...

# Webhook signing secret (stripe listen --forward-to localhost:3000/api/webhooks/stripe)
